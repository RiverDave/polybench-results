          %65 = cir.load align(4) %7 : !cir.ptr<!cir.int<s, 32>>, !cir.int<s, 32>
          %66 = cir.sub nsw %64, %65 : !cir.int<s, 32>
          %67 = cir.mul nsw %66, %2 : !cir.int<s, 32>
          %68 = cir.load align(4) %8 : !cir.ptr<!cir.int<s, 32>>, !cir.int<s, 32>
          %69 = cir.add nsw %67, %68 : !cir.int<s, 32>
          %70 = cir.cast integral %69 : !cir.int<s, 32> -> !cir.int<s, 64>
          %71 = cir.load align(8) %6 : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
          %72 = cir.ptr_stride %71, %70 : (!cir.ptr<!cir.float>, !cir.int<s, 64>) -> !cir.ptr<!cir.float>
          cir.store align(4) %63, %72 : !cir.float, !cir.ptr<!cir.float>
        }
      }
      cir.yield
    } cleanup all {
      cir.lifetime.end %8 : !cir.ptr<!cir.int<s, 32>>
      cir.yield
    }
    cir.return
  }
}
